diff --git a/btc-prophet/tests/test_learning_smart.py b/btc-prophet/tests/test_learning_smart.py
index 7fb9732..02517fd 100644
--- a/btc-prophet/tests/test_learning_smart.py
+++ b/btc-prophet/tests/test_learning_smart.py
@@ -129,3 +129,22 @@ def test_sampled_target_rescues_only_a_trade_that_reaches_it():
         replay(rows, lambda x: 0.9, checkpoint=False, exit_factor=1.4)["accounts"][0]["realized"]
         == hold["accounts"][0]["realized"]
     )
+
+
+def test_status_reports_optional_challenger_gate_separately(tmp_path):
+    s, _, _ = seed(tmp_path)
+    learner = Learning(s, tmp_path / "missing.sqlite")
+    learner.train()
+    waiting = s.get("learning_status")
+    assert waiting["status"] == "WAITING" and waiting["optional_challenger_shortage"] == 300
+    start = time.time() - 100000
+    with s.connect() as db:
+        for i in range(210):
+            db.execute("INSERT INTO learning_labels VALUES (?,?,?,?,?,?)",
+                       (f"fixture-{i}", start + i * 300, start + i * 300 + 240,
+                        json.dumps([i % 3, i % 4, -5.0]), i % 2, start + i * 300 + 241))
+    learner.train()
+    status = s.get("learning_status")
+    assert status["status"] == "SHADOW" and status["optional_challenger_minimum"] == 300
+    assert status["optional_challengers"]
+    assert all("300" in why for why in status["optional_challengers"].values())
diff --git a/btc-prophet/tests/test_unified_v321.py b/btc-prophet/tests/test_unified_v321.py
index 5db6140..9623a97 100644
--- a/btc-prophet/tests/test_unified_v321.py
+++ b/btc-prophet/tests/test_unified_v321.py
@@ -216,3 +216,26 @@ def test_actual_engine_entry_uses_fresh_book_and_preserves_old_ledgers(tmp_path)
     with store.connect() as db:
         assert unified.summary(db,now+1)["position"]["side"]=="UP"
         assert db.execute("SELECT count(*) FROM v2_orders").fetchone()[0]==0
+
+
+def test_late_data_block_does_not_overwrite_model_skip_reason(tmp_path):
+    store,_ = initialize(tmp_path)
+    with store.connect() as db:
+        # Model evaluates and skips: both sides priced outside the 40-70c band.
+        observe(db,1100,raw=.5,level=book(bid=.10,ask=.12))
+        first = db.execute("SELECT reason,model FROM unified_rounds").fetchone()
+        assert "PRICE_OUTSIDE_BAND" in first[0] and first[1]=="fixture"
+        # Book empties just before the close; the caller passes a pre-model block.
+        details = dict(window_start=1000,window_end=1300,book_checked=1299,reference_timestamp=1299)
+        unified.observe(db,"round",1299,"SIMULATE","momentum-book-v0.2",None,"NO_LIQUIDITY",
+                        details,dict(bids=[],asks=[]),TERMS,lambda: 1299)
+        row = db.execute("SELECT reason,model,observed FROM unified_rounds").fetchone()
+        assert (row[0],row[1]) == (first[0],first[1]) and row[2]==1299
+
+
+def test_data_blocks_alone_still_record_the_latest_block(tmp_path):
+    store,_ = initialize(tmp_path)
+    with store.connect() as db:
+        observe(db,1100,block="STALE_BOOK")
+        observe(db,1200,block="NO_LIQUIDITY")
+        assert db.execute("SELECT reason FROM unified_rounds").fetchone()[0]=="NO_LIQUIDITY"
